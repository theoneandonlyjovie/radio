<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/w_top"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

    <ImageView
        android:id="@+id/w_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/logo_bg"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_fg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="My Radio"
            android:textColor="#F3EAD9"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap play"
            android:textColor="#A99B85"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="Previous station"
        android:src="@drawable/ic_prev" />

    <ImageButton
        android:id="@+id/w_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/play_bg"
        android:contentDescription="Play or pause"
        android:src="@drawable/ic_play" />

    <ImageButton
        android:id="@+id/w_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="Next station"
        android:src="@drawable/ic_next" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/q0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <ImageView
                android:id="@+id/q0_img"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/logo_bg"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_fg" />

            <TextView
                android:id="@+id/q0_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:textColor="#F3EAD9"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/q1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <ImageView
                android:id="@+id/q1_img"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/logo_bg"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_fg" />

            <TextView
                android:id="@+id/q1_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:textColor="#F3EAD9"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/q2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <ImageView
                android:id="@+id/q2_img"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/logo_bg"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_fg" />

            <TextView
                android:id="@+id/q2_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:textColor="#F3EAD9"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/q3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <ImageView
                android:id="@+id/q3_img"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/logo_bg"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_fg" />

            <TextView
                android:id="@+id/q3_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:textColor="#F3EAD9"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
